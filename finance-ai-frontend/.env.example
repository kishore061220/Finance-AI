# Copy to .env.local and fill in to enable Firebase sign-in.
#
# The Firebase web config is not a secret: the API key is shipped to every
# browser that loads the app, and its security comes from HTTP referrer/domain
# restrictions configured in the Firebase console. It is kept out of version
# control so each deployment supplies its own.
#
# Leave every value blank to run against a backend with Firebase disabled. The
# app then offers the development-token form, which the API only serves when
# ALLOW_DEV_AUTH=true - so this fallback cannot become a production auth path.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Absolute API base URL. Leave unset to use relative /api paths, which is what
# you want when the app is served from the same origin as the backend, and what
# the dev server proxy expects.
# VITE_API_BASE_URL=https://api.example.com
