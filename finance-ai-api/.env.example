# ---------------------------------------------------------------------------
# Finance-AI backend configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored - never commit it.
# Every value below is optional: the app starts with an unconfigured-but-safe
# state, and each integration reports itself as "not configured" until set.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
APP_NAME=Finance-AI API
APP_ENV=development
DEBUG=false
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses to serve in production while this is empty.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated. Do not use "*" - the API rejects a wildcard with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CORS_ALLOW_CREDENTIALS=false

# Development-only token provider. Ignored automatically whenever Firebase is
# configured, and startup refuses to serve in production while it is true.
ALLOW_DEV_AUTH=false

# --- Database --------------------------------------------------------------
# Use a least-privileged application account, not the MySQL root user.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_ai
DB_ECHO=false

# --- Firebase Authentication (token verification) --------------------------
# Without these, every protected endpoint rejects real requests.
FIREBASE_PROJECT_ID=
# Either a path to the service-account JSON...
FIREBASE_CREDENTIALS_PATH=
# ...or the JSON itself. Never do both; the path wins.
FIREBASE_CREDENTIALS_JSON=

# --- Google Cloud Storage (remote backup) ---------------------------------
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Drive (remote backup) -----------------------------------------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_PATH=

# --- Financial assistant ---------------------------------------------------
# "builtin" needs no key and answers from the user's own data.
# Any other provider requires ASSISTANT_API_KEY.
ASSISTANT_PROVIDER=builtin
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_BASE_URL=

# --- Behaviour -------------------------------------------------------------
RECENT_TRANSACTION_LIMIT=10
